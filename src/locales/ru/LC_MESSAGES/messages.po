msgid "Login code"
msgstr "Код входа"

msgid "Welcome to our service!"
msgstr "Добро пожаловать в наш сервис!"

msgid "Your Login Code"
msgstr "Ваш код входа"

msgid "Authentication Code"
msgstr "Код аутентификации"

msgid "Hello,"
msgstr "Здравствуйте,"

msgid "You requested a login code for the account associated with"
msgstr "Вы запросили код входа для аккаунта, привязанного к"

msgid "Please use the following code to complete your sign-in process:"
msgstr "Используйте следующий код для завершения входа:"

msgid "This code is valid for"
msgstr "Код действителен в течение"

msgid "If it expires, you can request a new one on the login page."
msgstr "Если он истечёт, вы можете запросить новый на странице входа."

msgid ""
"If you did not request this code, please ignore this email. No one can "
"access your account without this code."
msgstr ""
"Если вы не запрашивали этот код, просто проигнорируйте это письмо. Никто "
"не сможет получить доступ к вашему аккаунту без него."

msgid "All rights reserved."
msgstr "Все права защищены."

msgid "This is an automated message, please do not reply directly to this email."
msgstr "Это автоматическое сообщение, пожалуйста, не отвечайте на него напрямую."

msgid "Welcome!"
msgstr "Добро пожаловать!"

msgid ""
"We are pleased to welcome you to our application. Your account has been "
"successfully created."
msgstr "Мы рады приветствовать вас в нашем приложении. Ваш аккаунт успешно создан."

msgid "If you have any questions, simply reply to this email."
msgstr "Если у вас есть вопросы, просто ответьте на это письмо."

msgid "This is an automated email, please do not reply to it."
msgstr "Это автоматическое письмо, пожалуйста, не отвечайте на него."

#, python-format
msgid "User with email %(email)s not found"
msgstr "Пользователь с email %(email)s не найден"

msgid "Code is invalid or expired"
msgstr "Код недействителен или истёк"

#, python-format
msgid "Code with id '%(code_id)s' not found"
msgstr "Код с id '%(code_id)s' не найден"

msgid "Maximum number of attempts exceeded"
msgstr "Превышено максимальное количество попыток"

#, python-format
msgid "User %(email)s is not active"
msgstr "Пользователь %(email)s неактивен"

#, python-format
msgid "Maximum number of attempts exceeded (%(max)s). Try again later"
msgstr "Превышено максимальное количество попыток (%(max)s). Попробуйте позже"

msgid "Token not found"
msgstr "Токен не найден"

